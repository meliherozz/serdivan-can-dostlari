{
  "kind": "collectionType",
  "collectionName": "breeds",
  "info": {
    "singularName": "breed",
    "pluralName": "breeds",
    "displayName": "Breed"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "species": {
      "type": "enumeration",
      "enum": ["dog", "cat", "other"],
      "required": true
    },
    "animals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::animal.animal",
      "mappedBy": "breed"
    }
  }
}
